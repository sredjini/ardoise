# LLM souverain Scaleway (EU) — API compatible OpenAI
SCW_API_KEY=your-scaleway-secret-key
SCW_URL=https://api.scaleway.ai/<project-id>/v1
SCW_MODEL=mistral-small-3.2-24b-instruct-2506

# Boucle de vérification : nb max de corrections automatiques
MAX_RETRIES=2

# Origines autorisées côté API (CORS), séparées par des virgules
ALLOW_ORIGINS=http://localhost:5173
